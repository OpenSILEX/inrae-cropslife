            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.opensilex.org/vocabulary/oeso#LiDAR"/>
                    <rdf:Description rdf:about="http://www.opensilex.org/vocabulary/oeso#Spectrometer"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
    </owl:ObjectProperty>
    



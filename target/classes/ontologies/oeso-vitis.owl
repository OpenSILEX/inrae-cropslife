        <rdfs:label xml:lang="en">weighing scale</rdfs:label>
    </owl:Class>
    


    <!-- http://www.opensilex.org/vocabulary/oeso#WindSensor -->

    <owl:Class rdf:about="http://www.opensilex.org/vocabulary/oeso#WindSensor">
        <rdfs:subClassOf rdf:resource="http://www.opensilex.org/vocabulary/oeso#SensingDevice"/>
        <rdfs:label xml:lang="fr">anémomètre</rdfs:label>
        <rdfs:label xml:lang="en">wind sensor</rdfs:label>
    </owl:Class>
    


    <!-- http://www.opensilex.org/vocabulary/oeso#WindVane -->

    <owl:Class rdf:about="http://www.opensilex.org/vocabulary/oeso#WindVane">
        <rdfs:subClassOf rdf:resource="http://www.opensilex.org/vocabulary/oeso#WindSensor"/>
        <source>skos:closeMatch Wind Vane [GAMP 2.4.1.5] http://www.wmo.int/pages/prog/wcp/agm/gamp/gamp_en.html</source>
        <rdfs:comment>The signal generator is a shaft angle transducer: potentiometers, alternating and direct current synchros, digital angle-encoder disks, direct reading dials, and rotary switches</rdfs:comment>
        <rdfs:label xml:lang="en">Wind Vane</rdfs:label>
        <rdfs:label xml:lang="fr">Wind Vane</rdfs:label>
    </owl:Class>
    


    <!-- http://www.opensilex.org/vocabulary/oeso-vitis#Berry -->

    <owl:Class rdf:about="http://www.opensilex.org/vocabulary/oeso-vitis#Berry">
        <rdfs:subClassOf rdf:resource="http://www.opensilex.org/vocabulary/oeso-vitis#PlantOrgan"/>
        <source>http://opendata.inrae.fr/gao/30050</source>
        <rdfs:comment xml:lang="en">A fruit (PO:0009001) which at maturity comprises a fleshy endocarp (PO:0009086), fleshy mesocarp (PO:0009087), and fleshy exocarp (PO:0009085)</rdfs:comment>
        <rdfs:comment xml:lang="fr">Fruit (PO : 0009001) qui, à maturité, comprend un endocarpe charnu (PO : 0009086), un mésocarpe charnu (PO : 0009087) et un exocarpe charnu (PO : 0009085).</rdfs:comment>
        <rdfs:label xml:lang="fr">Baie</rdfs:label>
        <rdfs:label xml:lang="en">Berry</rdfs:label>
    </owl:Class>
    


    <!-- http://www.opensilex.org/vocabulary/oeso-vitis#Block -->

    <owl:Class rdf:about="http://www.opensilex.org/vocabulary/oeso-vitis#Block">
        <rdfs:subClassOf rdf:resource="http://www.opensilex.org/vocabulary/oeso#ScientificObject"/>
        <rdfs:comment xml:lang="fr">Représentation struturelle d&apos;une ou plusieurs modalité(s) de facteur à laquelle est attachée des données.</rdfs:comment>
        <rdfs:comment xml:lang="en">Structural representation of one or several factor modality(-ies) to which data is attached.</rdfs:comment>
        <rdfs:label xml:lang="fr">Bloc</rdfs:label>
        <rdfs:label xml:lang="en">Block</rdfs:label>
    </owl:Class>
    


    <!-- http://www.opensilex.org/vocabulary/oeso-vitis#Bunch -->

    <owl:Class rdf:about="http://www.opensilex.org/vocabulary/oeso-vitis#Bunch">
        <rdfs:subClassOf rdf:resource="http://www.opensilex.org/vocabulary/oeso-vitis#PlantOrgan"/>
        <source>http://opendata.inrae.fr/gao/30060</source>
        <rdfs:comment xml:lang="fr">Infructescence : système de pousses reproductrices (PO : 0025082) qui se développe à partir d&apos;une inflorescence (PO : 0009049) et qui est une partie de chaque axe d&apos;infructescence (PO : 0025242) et tous les fruits (PO : 0009001) portés par ces axes.</rdfs:comment>
        <rdfs:comment xml:lang="en">Infructescence: a reproductive shoot system (PO:0025082) that develops from an inflorescence (PO:0009049) and has as parts each infructescence axis (PO:0025242) and all of the fruits (PO:0009001) borne by those axes. 

Synonym : Grappe cluster</rdfs:comment>
        <rdfs:label xml:lang="en">Bunch</rdfs:label>
        <rdfs:label xml:lang="fr">Grappe</rdfs:label>
    </owl:Class>
    


    <!-- http://www.opensilex.org/vocabulary/oeso-vitis#CoverCrop -->

    <owl:Class rdf:about="http://www.opensilex.org/vocabulary/oeso-vitis#CoverCrop">
        <rdfs:subClassOf rdf:resource="http://www.opensilex.org/vocabulary/oeso#ScientificObject"/>
        <source>Definition: Nathan L. Hartwig, and Hans Ulrich Ammon. “Cover Crops and Living Mulches.” Weed Science, vol. 50, no. 6, 2002, pp. 688–99. JSTOR, http://www.jstor.org/stable/4046641. Accessed 31 Oct. 2025.</source>
        <rdfs:comment xml:lang="fr">Couverture végétale vivante qui est semée ou pousse de manière spontannée pendant ou après une culture principale, puis généralement détruite avant la plantation de la culture suivante. 

Synonyme: Couverture végétale</rdfs:comment>
        <rdfs:comment xml:lang="en">Living ground cover that is planted or grows spontaneously into or after a main crop and then commonly killed before the next crop is planted.</rdfs:comment>
        <rdfs:label xml:lang="fr">Couvert végétal</rdfs:label>
        <rdfs:label xml:lang="en">Cover crop</rdfs:label>
    </owl:Class>
    


    <!-- http://www.opensilex.org/vocabulary/oeso-vitis#ExperimentalPlot -->

    <owl:Class rdf:about="http://www.opensilex.org/vocabulary/oeso-vitis#ExperimentalPlot">
        <rdfs:subClassOf rdf:resource="http://www.opensilex.org/vocabulary/oeso-vitis#PlotComponent"/>
        <rdfs:comment xml:lang="en">An experimental plot or experimental plot is an experimental unit corresponding to a typically rectangular (but not necessarily) area of land large enough to receive an experimental treatment and allow for observation. Consequently, an experimental plot is large enough to cultivate one or more plants.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Une placette expérimentale est une unité expérimentale correspondant à une zone de terrain généralement de forme rectangulaire (mais pas nécessairement) suffisamment grande pour recevoir un traitement expérimental et réaliser des observations. Par conséquent une parcelle expérimentale est suffisamment grande pour cultiver une à plusieurs plantes.</rdfs:comment>
        <rdfs:label xml:lang="fr">Placette</rdfs:label>
        <rdfs:label xml:lang="en">Plot</rdfs:label>
        <skos:altLabel xml:lang="fr">Micro Parcelle</skos:altLabel>
        <skos:note>European and Mediterranean Plant Protection Organization / Organisation Européenne et Méditerranéenne pour la Protection des Plantes. &quot;PP1/152(4)- Design and analysis of efﬁcacy evaluation trials&quot; in Bulletin OEPP/EPPO, 2012, 42 (3), pp 367-381, ISSN 0250-8052. DOI: 10.1111/epp.2610, https://pp1.eppo.int/standards/PP1-152-4</skos:note>
    </owl:Class>
    


    <!-- http://www.opensilex.org/vocabulary/oeso-vitis#GroupOfGrapeVines -->

    <owl:Class rdf:about="http://www.opensilex.org/vocabulary/oeso-vitis#GroupOfGrapeVines">
        <rdfs:subClassOf rdf:resource="http://www.opensilex.org/vocabulary/oeso#ScientificObject"/>
        <source xml:lang="fr">Définition donnée pour la déclaration du dispositif VitAdapt -&gt; A valider par Agnès Destrac</source>
        <rdfs:comment xml:lang="fr">Regroupement de plantes selon des critères permettant une étude commune des ceps.</rdfs:comment>
        <rdfs:label xml:lang="en">Group of grapevines</rdfs:label>
        <rdfs:label xml:lang="fr">Groupe de ceps</rdfs:label>
        <rdfs:label xml:lang="en">Grouping of plants according to criteria allowing for a common study of grapevines.</rdfs:label>
    </owl:Class>
    


    <!-- http://www.opensilex.org/vocabulary/oeso-vitis#GroupsOfExperimentalPlot -->

    <owl:Class rdf:about="http://www.opensilex.org/vocabulary/oeso-vitis#GroupsOfExperimentalPlot">
        <rdfs:subClassOf rdf:resource="http://www.opensilex.org/vocabulary/oeso#ScientificObject"/>
        <source xml:lang="fr">A valider par un groupe d&apos;expert. Définition réalisée en partant des données expérimentales.</source>
        <source xml:lang="en">To be validated by a group of experts. Definition developed based on experimental data.</source>
        <rdfs:comment xml:lang="en">Grouping of plots according to the criteria of a site-scale experimental study. (Experimental modalities, environmental structure - ex: road crossing)</rdfs:comment>
        <rdfs:comment xml:lang="fr">Regroupement de placettes qui suit des critères d&apos;une étude expérimentale à l&apos;échelle d&apos;un site. (Modalité expérimental, structure de l&apos;environnement  - passage d&apos;une route)</rdfs:comment>
        <rdfs:label>Group of plots</rdfs:label>
        <rdfs:label xml:lang="fr">Groupe de placettes</rdfs:label>
    </owl:Class>
    


    <!-- http://www.opensilex.org/vocabulary/oeso-vitis#Inflorescence -->

    <owl:Class rdf:about="http://www.opensilex.org/vocabulary/oeso-vitis#Inflorescence">
        <rdfs:subClassOf rdf:resource="http://www.opensilex.org/vocabulary/oeso-vitis#PlantOrgan"/>
        <source>http://opendata.inrae.fr/gao/30080</source>
        <rdfs:comment xml:lang="en">A reproductive shoot system (PO:0025082) that has as parts all of the shoot axes (PO:0025029) and flowers (PO:0009046; must have two or more) distal to the most distal leaf (PO:0009025).</rdfs:comment>
        <rdfs:comment xml:lang="fr">Système de pousse reproducteur (PO : 0025082) comprenant toutes les pousses axiales (PO : 0025029) et les fleurs (PO : 0009046 ; doit en comporter au moins deux) situées à l&apos;extrémité de la feuille la plus distale (PO : 0009025).</rdfs:comment>
        <rdfs:label xml:lang="en">Inflorescence</rdfs:label>
        <rdfs:label xml:lang="fr">Inflorescence</rdfs:label>
    </owl:Class>
    


    <!-- http://www.opensilex.org/vocabulary/oeso-vitis#Leaf -->

    <owl:Class rdf:about="http://www.opensilex.org/vocabulary/oeso-vitis#Leaf">
        <rdfs:subClassOf rdf:resource="http://www.opensilex.org/vocabulary/oeso-vitis#PlantOrgan"/>
        <source>http://opendata.inrae.fr/gao/20010</source>
        <rdfs:comment xml:lang="en">A phyllome (PO:0006001) that is not associated with a reproductive structure</rdfs:comment>
        <rdfs:comment xml:lang="fr">Phyllome (PO:0006001) n&apos;étant pas associé à une structure reproductive</rdfs:comment>
        <rdfs:label xml:lang="fr">Feuille</rdfs:label>
        <rdfs:label xml:lang="en">Leaf</rdfs:label>
    </owl:Class>
    


    <!-- http://www.opensilex.org/vocabulary/oeso-vitis#PlantOrgan -->

    <owl:Class rdf:about="http://www.opensilex.org/vocabulary/oeso-vitis#PlantOrgan">
        <rdfs:subClassOf rdf:resource="http://www.opensilex.org/vocabulary/oeso#ScientificObject"/>
        <source>https://amigo.geneontology.org/amigo/term/PO:0009008</source>
        <rdfs:comment xml:lang="en">A multi-tissue plant structure (PO:0025496) that is a functional unit, is a proper part of a whole plant (PO:0000003), and includes portions of plant tissue (PO:0009007) of at least two different types that derive from a common developmental path.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Structure végétale multitissulaire (PO:0025496) qui est une unité fonctionnelle, qui fait partie intégrante d&apos;une plante entière (PO:0000003) et comprend des parties de tissus végétaux (PO:0009007) d&apos;au moins deux types différents issus d&apos;un processus de développement commun.</rdfs:comment>
        <rdfs:label xml:lang="fr">Organe de plante</rdfs:label>
        <rdfs:label xml:lang="en">Plant organ</rdfs:label>
    </owl:Class>
    


    <!-- http://www.opensilex.org/vocabulary/oeso-vitis#PlotComponent -->

    <owl:Class rdf:about="http://www.opensilex.org/vocabulary/oeso-vitis#PlotComponent">
        <rdfs:subClassOf rdf:resource="http://www.opensilex.org/vocabulary/oeso#ScientificObject"/>
        <rdfs:comment xml:lang="en">Component corresponding to a subdivision of “Unit Parcel”</rdfs:comment>
        <rdfs:comment xml:lang="fr">Composant correspondant à une subdivison de &quot;Parcelle Unitaire&quot;</rdfs:comment>
        <rdfs:label xml:lang="fr">Composant Parcellaire</rdfs:label>
        <rdfs:label xml:lang="en">Plot Component</rdfs:label>
    </owl:Class>
    


    <!-- http://www.opensilex.org/vocabulary/oeso-vitis#PrimaryShoot -->

    <owl:Class rdf:about="http://www.opensilex.org/vocabulary/oeso-vitis#PrimaryShoot">
        <rdfs:subClassOf rdf:resource="http://www.opensilex.org/vocabulary/oeso-vitis#Shoot"/>
        <source>http://opendata.inrae.fr/gao/20031</source>
        <rdfs:comment xml:lang="fr">Rameau issue d&apos;un bourgeon hivernal primaire</rdfs:comment>
        <rdfs:comment xml:lang="en">shoot arising from a primary winter bud</rdfs:comment>
        <rdfs:label xml:lang="en">Primary shoot</rdfs:label>
        <rdfs:label xml:lang="fr">Rameau principal</rdfs:label>
    </owl:Class>
    


    <!-- http://www.opensilex.org/vocabulary/oeso-vitis#Quadrat -->

    <owl:Class rdf:about="http://www.opensilex.org/vocabulary/oeso-vitis#Quadrat">
        <rdfs:subClassOf rdf:resource="http://www.opensilex.org/vocabulary/oeso-vitis#PlotComponent"/>
        <rdfs:label xml:lang="en">Quadrat</rdfs:label>
        <rdfs:label xml:lang="fr">Quadrat</rdfs:label>
    </owl:Class>
    


    <!-- http://www.opensilex.org/vocabulary/oeso-vitis#SecondaryShoot -->

    <owl:Class rdf:about="http://www.opensilex.org/vocabulary/oeso-vitis#SecondaryShoot">
        <rdfs:subClassOf rdf:resource="http://www.opensilex.org/vocabulary/oeso-vitis#Shoot"/>
        <source>http://opendata.inrae.fr/gao/20032</source>
        <rdfs:comment xml:lang="fr">Rameau issue d&apos;un bourgeon hivernal secondaire</rdfs:comment>
        <rdfs:comment xml:lang="en">Shoot arising from a secondary winter bud</rdfs:comment>
        <rdfs:label xml:lang="fr">Rameau secondaire</rdfs:label>
        <rdfs:label xml:lang="en">Secondary shoot</rdfs:label>
    </owl:Class>
    


    <!-- http://www.opensilex.org/vocabulary/oeso-vitis#Shoot -->

    <owl:Class rdf:about="http://www.opensilex.org/vocabulary/oeso-vitis#Shoot">
        <rdfs:subClassOf rdf:resource="http://www.opensilex.org/vocabulary/oeso-vitis#PlantOrgan"/>
        <source>http://opendata.inrae.fr/gao/20030</source>
        <rdfs:comment xml:lang="en">A collective plant organ structure (PO:0025007) that produces shoot-borne portions of meristem tissue (PO:0009013) and the plant structures (PO:0009011) that arise from them</rdfs:comment>
        <rdfs:comment xml:lang="fr">Structure collective d&apos;organe végétatif (PO:0025007) qui produit des morceaux de pousses issus de tissus méristématiques (PO:0009013) et les structures végétales (PO:0009011) qui en découlent.</rdfs:comment>
        <rdfs:label xml:lang="fr">Rameau</rdfs:label>
        <rdfs:label xml:lang="en">Shoot</rdfs:label>
    </owl:Class>
    


    <!-- http://www.opensilex.org/vocabulary/oeso-vitis#Transect -->

    <owl:Class rdf:about="http://www.opensilex.org/vocabulary/oeso-vitis#Transect">
        <rdfs:subClassOf rdf:resource="http://www.opensilex.org/vocabulary/oeso-vitis#PlotComponent"/>
        <rdfs:label xml:lang="en">Transect</rdfs:label>
        <rdfs:label xml:lang="fr">Transect</rdfs:label>
    </owl:Class>
    


    <!-- http://www.opensilex.org/vocabulary/oeso-vitis#Trunk -->

    <owl:Class rdf:about="http://www.opensilex.org/vocabulary/oeso-vitis#Trunk">
        <rdfs:subClassOf rdf:resource="http://www.opensilex.org/vocabulary/oeso-vitis#PlantOrgan"/>
        <source>http://opendata.inrae.fr/gao/40060</source>
        <rdfs:comment xml:lang="fr">Structure ligneuse d&apos;un cep de vigne (cordon : tronc horizontal)</rdfs:comment>
        <rdfs:comment xml:lang="en">Wood structure of a grapevine plant (cordon : horizontal trunk)</rdfs:comment>
        <rdfs:label xml:lang="fr">Tronc</rdfs:label>
        <rdfs:label xml:lang="en">Trunk</rdfs:label>
    </owl:Class>
    


    <!-- http://www.opensilex.org/vocabulary/oeso-vitis#Vinestock -->

    <owl:Class rdf:about="http://www.opensilex.org/vocabulary/oeso-vitis#Vinestock">
        <rdfs:subClassOf rdf:resource="http://www.opensilex.org/vocabulary/oeso#Plant"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.opensilex.org/vocabulary/oeso#hasGermplasm"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</owl:maxQualifiedCardinality>
                <owl:onClass rdf:resource="http://www.opensilex.org/vocabulary/oeso-vitis#Vinestock"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.opensilex.org/vocabulary/oeso-vitis#hasGraft"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onClass rdf:resource="http://www.opensilex.org/vocabulary/oeso-vitis#Vinestock"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.opensilex.org/vocabulary/oeso-vitis#hasRootstock"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onClass rdf:resource="http://www.opensilex.org/vocabulary/oeso-vitis#Vinestock"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="fr">Plante entière de vigne comprenant l&apos;ensemble des organes.

Synonyme: Plant de vigne</rdfs:comment>
        <rdfs:comment xml:lang="en">The entire vine plant, including all of its organs.

Synonym : Vine</rdfs:comment>
        <rdfs:label xml:lang="fr">Cep</rdfs:label>
        <rdfs:label xml:lang="en">Vinestock</rdfs:label>
    </owl:Class>
    


    <!-- http://www.opensilex.org/vocabulary/oeso-vitis#Weed -->

    <owl:Class rdf:about="http://www.opensilex.org/vocabulary/oeso-vitis#Weed">
        <rdfs:subClassOf rdf:resource="http://www.opensilex.org/vocabulary/oeso-vitis#CoverCrop"/>
        <source>Definition: Biswanath Saha, Chaichi Devi, Meena Khwairakpam, and Ajay S.Kalamdhad. Vermicomposting and anaerobic digestion – viable alternative options for terrestrial weed management – a review. Biotechnology Reports, 17 :70–76, 2018. https://doi.org/10.1016/j.btre.2017.11.005.</source>
        <rdfs:comment xml:lang="fr">Plantes indésirables qui poussent à des endroits et à des périodes inopportunes, entrant en concurrence avec les cultures et pouvant causer des pertes économiques.</rdfs:comment>
        <rdfs:comment xml:lang="en">Uninvited plants which are grown in undesirable place and period causing competition for cultivated crops and can do economic loss.</rdfs:comment>
        <rdfs:label xml:lang="fr">Adventice</rdfs:label>
        <rdfs:label xml:lang="en">Weed</rdfs:label>
    </owl:Class>
    


    <!-- http://www.opensilex.org/vocabulary/oeso-vitis#petiole -->

    <owl:Class rdf:about="http://www.opensilex.org/vocabulary/oeso-vitis#petiole">
        <rdfs:subClassOf rdf:resource="http://www.opensilex.org/vocabulary/oeso-vitis#PlantOrgan"/>
        <source>https://browser.planteome.org/amigo/term/PO:0020038</source>
        <rdfs:comment xml:lang="en">A stalk (PO:0025066) of a vascular leaf (PO:0009025).</rdfs:comment>
        <rdfs:comment xml:lang="fr">Tige (PO : 0025066) d&apos;une feuille vasculaire (PO : 0009025).</rdfs:comment>
        <rdfs:label xml:lang="en">Petiole</rdfs:label>
        <rdfs:label xml:lang="fr">Pétiole</rdfs:label>
    </owl:Class>
    


    <!-- http://xmlns.com/foaf/0.1/Organization -->

    <owl:Class rdf:about="http://xmlns.com/foaf/0.1/Organization">
        <rdfs:subClassOf rdf:resource="http://www.opensilex.org/vocabulary/oeso#ExperimentalCondition"/>
    </owl:Class>
    



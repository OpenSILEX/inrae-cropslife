    <owl:Class rdf:about="http://www.opensilex.org/vocabulary/oeso#PyranometerWithShadeRing">
        <rdfs:subClassOf rdf:resource="http://www.opensilex.org/vocabulary/oeso#RadiationSensor"/>
        <source>skos:broaderMatch solarimeter (pyranometer) [GAMP 2.3.1.1] http://www.wmo.int/pages/prog/wcp/agm/gamp/gamp_en.html</source>
        <rdfs:label xml:lang="en">pyranometer with shade ring</rdfs:label>
        <rdfs:label xml:lang="fr">pyranometer with shade ring</rdfs:label>
    </owl:Class>
    


    <!-- http://www.opensilex.org/vocabulary/oeso#QuantumSensor -->

    <owl:Class rdf:about="http://www.opensilex.org/vocabulary/oeso#QuantumSensor">
        <rdfs:subClassOf rdf:resource="http://www.opensilex.org/vocabulary/oeso#RadiationSensor"/>
        <source>skos:closeMatch quantum sensor [GAMP 2.4.1.1] http://www.wmo.int/pages/prog/wcp/agm/gamp/gamp_en.html</source>
        <rdfs:comment>measure the PAR directly in the range 0.4 to 0.7 micrometers</rdfs:comment>
        <rdfs:label xml:lang="en">quantum sensor</rdfs:label>
        <rdfs:label xml:lang="fr">quantum sensor</rdfs:label>
    </owl:Class>
    


    <!-- http://www.opensilex.org/vocabulary/oeso#RGBCamera -->

    <owl:Class rdf:about="http://www.opensilex.org/vocabulary/oeso#RGBCamera">
        <rdfs:subClassOf rdf:resource="http://www.opensilex.org/vocabulary/oeso#Camera"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.opensilex.org/vocabulary/oeso#hasLens"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://www.opensilex.org/vocabulary/oeso#Lens"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.opensilex.org/vocabulary/oeso#height"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.opensilex.org/vocabulary/oeso#pixelSize"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.opensilex.org/vocabulary/oeso#width"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">RGB camera</rdfs:label>
        <rdfs:label xml:lang="fr">caméra RGB</rdfs:label>
    </owl:Class>
    


    <!-- http://www.opensilex.org/vocabulary/oeso#RadiationSensor -->

    <owl:Class rdf:about="http://www.opensilex.org/vocabulary/oeso#RadiationSensor">
        <rdfs:subClassOf rdf:resource="http://www.opensilex.org/vocabulary/oeso#SensingDevice"/>
        <rdfs:label xml:lang="fr">capteur de rayonnement</rdfs:label>
        <rdfs:label xml:lang="en">radiation sensor</rdfs:label>
    </owl:Class>
    


    <!-- http://www.opensilex.org/vocabulary/oeso#ResearchDepartment -->

    <owl:Class rdf:about="http://www.opensilex.org/vocabulary/oeso#ResearchDepartment">
        <rdfs:subClassOf rdf:resource="http://xmlns.com/foaf/0.1/Organization"/>
        <rdfs:label xml:lang="fr">Département de recherche</rdfs:label>
        <rdfs:label xml:lang="en">Research Department</rdfs:label>
    </owl:Class>
    


    <!-- http://www.opensilex.org/vocabulary/oeso#ResearchInfrastructure -->

    <owl:Class rdf:about="http://www.opensilex.org/vocabulary/oeso#ResearchInfrastructure">
        <rdfs:subClassOf rdf:resource="http://xmlns.com/foaf/0.1/Organization"/>
        <rdfs:label xml:lang="fr">Infrastructure de Recherche</rdfs:label>
        <rdfs:label xml:lang="en">Research Infrastructure</rdfs:label>
    </owl:Class>
    


    <!-- http://www.opensilex.org/vocabulary/oeso#ResearchInstitut -->

    <owl:Class rdf:about="http://www.opensilex.org/vocabulary/oeso#ResearchInstitut">
        <rdfs:subClassOf rdf:resource="http://xmlns.com/foaf/0.1/Organization"/>
        <rdfs:label xml:lang="fr">Institut de Recherche</rdfs:label>
        <rdfs:label xml:lang="en">Research Institut</rdfs:label>
    </owl:Class>
    


    <!-- http://www.opensilex.org/vocabulary/oeso#Root -->

    <owl:Class rdf:about="http://www.opensilex.org/vocabulary/oeso#Root">
        <rdfs:subClassOf rdf:resource="http://www.opensilex.org/vocabulary/oeso-vitis#PlantOrgan"/>
        <source>http://opendata.inrae.fr/gao/40010</source>
        <rdfs:comment xml:lang="en">A plant axis (PO:0025004) that lacks shoot axis nodes (PO:0005004) and usually grows indeterminately.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Axe végétal (PO:0025004) dépourvu de nœuds d&apos;axe de pousse (PO:0005004) et qui pousse généralement de manière indéterminée.</rdfs:comment>
        <rdfs:label xml:lang="fr">Racine</rdfs:label>
        <rdfs:label xml:lang="en">Root</rdfs:label>
    </owl:Class>
    


    <!-- http://www.opensilex.org/vocabulary/oeso#Row -->

    <owl:Class rdf:about="http://www.opensilex.org/vocabulary/oeso#Row">
        <rdfs:subClassOf rdf:resource="http://www.opensilex.org/vocabulary/oeso-vitis#PlotComponent"/>
        <rdfs:comment xml:lang="en">Component of “Unitary Plot” corresponding to a row of plants.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Composant de &quot;Parcelle Unitaire&quot; correspondant à un alignement de plantes.</rdfs:comment>
        <rdfs:label xml:lang="fr">Rang</rdfs:label>
        <rdfs:label xml:lang="en">Row</rdfs:label>
    </owl:Class>
    


    <!-- http://www.opensilex.org/vocabulary/oeso#ScientificObject -->

    <owl:Class rdf:about="http://www.opensilex.org/vocabulary/oeso#ScientificObject">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.opensilex.org/vocabulary/oeso#hasReplication"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="fr">Entité physique qui est la principale unité d&apos;intérêt, sur laquelle sont réalisées des observations, mesures ou prélèvements.</rdfs:comment>
        <rdfs:comment xml:lang="en">Physical entity that is the main unit of interest, on which observations, measurements, or samples are taken.</rdfs:comment>
        <rdfs:label xml:lang="fr">Objet Scientifique</rdfs:label>
        <rdfs:label xml:lang="en">Scientific Object</rdfs:label>
    </owl:Class>
    


    <!-- http://www.opensilex.org/vocabulary/oeso#SensingDevice -->

    <owl:Class rdf:about="http://www.opensilex.org/vocabulary/oeso#SensingDevice">
        <rdfs:subClassOf rdf:resource="http://www.opensilex.org/vocabulary/oeso#Device"/>
    </owl:Class>
    


    <!-- http://www.opensilex.org/vocabulary/oeso#Shadows -->

    <owl:Class rdf:about="http://www.opensilex.org/vocabulary/oeso#Shadows">
        <rdfs:subClassOf rdf:resource="http://www.opensilex.org/vocabulary/oeso#Actuator"/>
        <rdfs:label xml:lang="fr">ombrière</rdfs:label>
        <rdfs:label xml:lang="en">shadows</rdfs:label>
    </owl:Class>
    


    <!-- http://www.opensilex.org/vocabulary/oeso#Spectrometer -->

    <owl:Class rdf:about="http://www.opensilex.org/vocabulary/oeso#Spectrometer">
        <rdfs:subClassOf rdf:resource="http://www.opensilex.org/vocabulary/oeso#SensingDevice"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.opensilex.org/vocabulary/oeso#halfFieldOfView"/>
                <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.opensilex.org/vocabulary/oeso#maxWavelength"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.opensilex.org/vocabulary/oeso#minWavelength"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.opensilex.org/vocabulary/oeso#spectralSamplingInterval"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">Spectrometer</rdfs:label>
        <rdfs:label xml:lang="fr">Spectromètre</rdfs:label>
    </owl:Class>
    


    <!-- http://www.opensilex.org/vocabulary/oeso#Spectroradiometer -->

    <owl:Class rdf:about="http://www.opensilex.org/vocabulary/oeso#Spectroradiometer">
        <rdfs:subClassOf rdf:resource="http://www.opensilex.org/vocabulary/oeso#SensingDevice"/>
        <rdfs:label xml:lang="en">spectroradiometer</rdfs:label>
        <rdfs:label xml:lang="fr">spectroradiometre</rdfs:label>
    </owl:Class>
    


    <!-- http://www.opensilex.org/vocabulary/oeso#SurfaceTemperatureRadiometer -->

    <owl:Class rdf:about="http://www.opensilex.org/vocabulary/oeso#SurfaceTemperatureRadiometer">
        <rdfs:subClassOf rdf:resource="http://www.opensilex.org/vocabulary/oeso#RadiationSensor"/>
        <source>skos:closeMatch surface temperature radiometer [GAMP 2.4.1.1] http://www.wmo.int/pages/prog/wcp/agm/gamp/gamp_en.html</source>
        <rdfs:comment>measurements of infra-red radiation emitted from near or remote surfaces</rdfs:comment>
        <rdfs:label xml:lang="en">surface temperature radiometer</rdfs:label>
        <rdfs:label xml:lang="fr">surface temperature radiometer</rdfs:label>
    </owl:Class>
    


    <!-- http://www.opensilex.org/vocabulary/oeso#TIRCamera -->

    <owl:Class rdf:about="http://www.opensilex.org/vocabulary/oeso#TIRCamera">
        <rdfs:subClassOf rdf:resource="http://www.opensilex.org/vocabulary/oeso#Camera"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.opensilex.org/vocabulary/oeso#waveband"/>
                <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.opensilex.org/vocabulary/oeso#hasLens"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://www.opensilex.org/vocabulary/oeso#Lens"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.opensilex.org/vocabulary/oeso#height"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.opensilex.org/vocabulary/oeso#pixelSize"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.opensilex.org/vocabulary/oeso#width"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">IR thermal camera</rdfs:label>
        <rdfs:label xml:lang="fr">caméra infrarouge thermique</rdfs:label>
    </owl:Class>
    


    <!-- http://www.opensilex.org/vocabulary/oeso#TemperatureSensor -->

    <owl:Class rdf:about="http://www.opensilex.org/vocabulary/oeso#TemperatureSensor">
        <rdfs:subClassOf rdf:resource="http://www.opensilex.org/vocabulary/oeso#SensingDevice"/>
        <rdfs:label xml:lang="fr">capteur de température</rdfs:label>
        <rdfs:label xml:lang="en">temperature sensor</rdfs:label>
    </owl:Class>
    


    <!-- http://www.opensilex.org/vocabulary/oeso#Tensiometer -->

    <owl:Class rdf:about="http://www.opensilex.org/vocabulary/oeso#Tensiometer">
        <rdfs:subClassOf rdf:resource="http://www.opensilex.org/vocabulary/oeso#HumiditySensor"/>
        <source>skos:closeMatch Tensiometer [GAMP 2.4.1.6.2] http://www.wmo.int/pages/prog/wcp/agm/gamp/gamp_en.html</source>
        <rdfs:label xml:lang="en">tensiometer</rdfs:label>
        <rdfs:label xml:lang="fr">tensiomètre</rdfs:label>
    </owl:Class>
    


    <!-- http://www.opensilex.org/vocabulary/oeso#Thermistor -->

    <owl:Class rdf:about="http://www.opensilex.org/vocabulary/oeso#Thermistor">
        <rdfs:subClassOf rdf:resource="http://www.opensilex.org/vocabulary/oeso#TemperatureSensor"/>
        <source>skos:closeMatch Thermistor [GAMP 2.4.1.2] http://www.wmo.int/pages/prog/wcp/agm/gamp/gamp_en.html</source>
        <rdfs:comment>Based on the variation of resistance of a semiconductor with a relatively large temperature coefficient of resistance, either positive (PTC) or negative (NTC) depending upon the actual material</rdfs:comment>
        <rdfs:label xml:lang="en">thermistor</rdfs:label>
        <rdfs:label xml:lang="fr">thermistor</rdfs:label>
    </owl:Class>
    


    <!-- http://www.opensilex.org/vocabulary/oeso#Thermocouple -->

    <owl:Class rdf:about="http://www.opensilex.org/vocabulary/oeso#Thermocouple">
        <rdfs:subClassOf rdf:resource="http://www.opensilex.org/vocabulary/oeso#TemperatureSensor"/>
        <source>skos:closeMatch Thermocouple [GAMP 2.4.1.2] http://www.wmo.int/pages/prog/wcp/agm/gamp/gamp_en.html</source>
        <rdfs:comment>Based on the generation of an electromotive force at the junction between two metals in contact, which is function of the temperature of the two metals</rdfs:comment>
        <rdfs:label xml:lang="en">thermocouple</rdfs:label>
        <rdfs:label xml:lang="fr">thermocouple</rdfs:label>
    </owl:Class>
    


    <!-- http://www.opensilex.org/vocabulary/oeso#TippingBucketRainGauge -->

    <owl:Class rdf:about="http://www.opensilex.org/vocabulary/oeso#TippingBucketRainGauge">
        <rdfs:subClassOf rdf:resource="http://www.opensilex.org/vocabulary/oeso#PrecipitationSensor"/>
        <source>skos:closeMatch Tipping bucket rain gauge [IOM-99_FI-RI 2.2.1a-d] http://www.wmo.int/pages/prog/www/IMOP/publications/IOM-99_FI-RI.pdf</source>
        <rdfs:comment>Tipping balance of two buckets</rdfs:comment>
        <rdfs:label xml:lang="en">Tipping bucket rain gauge</rdfs:label>
        <rdfs:label xml:lang="fr">Tipping bucket rain gauge</rdfs:label>
    </owl:Class>
    


    <!-- http://www.opensilex.org/vocabulary/oeso#TippingBucketRainGaugeTbrgWithoutCorrection -->

    <owl:Class rdf:about="http://www.opensilex.org/vocabulary/oeso#TippingBucketRainGaugeTbrgWithoutCorrection">
        <rdfs:subClassOf rdf:resource="http://www.opensilex.org/vocabulary/oeso#TippingBucketRainGauge"/>
        <rdfs:comment>Tipping balance of two buckets</rdfs:comment>
        <rdfs:label xml:lang="en">Tipping-bucket rain gauge (TBRG) without correction</rdfs:label>
        <rdfs:label xml:lang="fr">Tipping-bucket rain gauge (TBRG) without correction</rdfs:label>
    </owl:Class>
    


    <!-- http://www.opensilex.org/vocabulary/oeso#TippingBucketRainGaugeWithCorrectionAlgorithmTbrgSc -->

    <owl:Class rdf:about="http://www.opensilex.org/vocabulary/oeso#TippingBucketRainGaugeWithCorrectionAlgorithmTbrgSc">
        <rdfs:subClassOf rdf:resource="http://www.opensilex.org/vocabulary/oeso#TippingBucketRainGauge"/>
        <rdfs:comment>Tipping balance of two buckets</rdfs:comment>
        <rdfs:label xml:lang="en">Tipping-bucket rain gauge with correction algorithm (TBRG-SC)</rdfs:label>
        <rdfs:label xml:lang="fr">Tipping-bucket rain gauge with correction algorithm (TBRG-SC)</rdfs:label>
    </owl:Class>
    


    <!-- http://www.opensilex.org/vocabulary/oeso#TippingBucketRainGaugeWithExtraPulseCorrectionTbrgPc -->

    <owl:Class rdf:about="http://www.opensilex.org/vocabulary/oeso#TippingBucketRainGaugeWithExtraPulseCorrectionTbrgPc">
        <rdfs:subClassOf rdf:resource="http://www.opensilex.org/vocabulary/oeso#TippingBucketRainGauge"/>
        <rdfs:comment>Tipping balance of two buckets</rdfs:comment>
        <rdfs:label xml:lang="en">Tipping-bucket rain gauge with extra pulse correction (TBRG-PC)</rdfs:label>
        <rdfs:label xml:lang="fr">Tipping-bucket rain gauge with extra pulse correction (TBRG-PC)</rdfs:label>
    </owl:Class>
    


    <!-- http://www.opensilex.org/vocabulary/oeso#TippingBucketRainGaugeWithMechanicalCorrectionTbrgMc -->

    <owl:Class rdf:about="http://www.opensilex.org/vocabulary/oeso#TippingBucketRainGaugeWithMechanicalCorrectionTbrgMc">
        <rdfs:subClassOf rdf:resource="http://www.opensilex.org/vocabulary/oeso#TippingBucketRainGauge"/>
        <rdfs:comment>Tipping balance of two buckets</rdfs:comment>
        <rdfs:label xml:lang="en">Tipping-bucket rain gauge with mechanical correction (TBRG-MC)</rdfs:label>
        <rdfs:label xml:lang="fr">Tipping-bucket rain gauge with mechanical correction (TBRG-MC)</rdfs:label>
    </owl:Class>
    


    <!-- http://www.opensilex.org/vocabulary/oeso#Tree -->

    <owl:Class rdf:about="http://www.opensilex.org/vocabulary/oeso#Tree">
        <rdfs:subClassOf rdf:resource="http://www.opensilex.org/vocabulary/oeso#Plant"/>
        <source>Definition: Philip Wilson. The meaning of ’tree’. The Arb Magazine : Newsletter of the Arbori-cultural Association, 166 :32–33, 01 2014.</source>
        <rdfs:comment xml:lang="en">Perennial woody plant growing to a considerable height and size, with a self-supporting main stem and usually developing branches at some distance from the ground.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Plante ligneuse vivace atteignant une hauteur et une taille considérables, avec une tige principale autoportante et développant généralement des branches à une certaine distance du sol.</rdfs:comment>
        <rdfs:label xml:lang="fr">Arbre</rdfs:label>
        <rdfs:label xml:lang="en">Tree</rdfs:label>
    </owl:Class>
    


    <!-- http://www.opensilex.org/vocabulary/oeso#UAV -->

    <owl:Class rdf:about="http://www.opensilex.org/vocabulary/oeso#UAV">
        <rdfs:subClassOf rdf:resource="http://www.opensilex.org/vocabulary/oeso#Vector"/>
        <rdfs:label xml:lang="fr">drone</rdfs:label>
        <rdfs:label xml:lang="en">uav</rdfs:label>
    </owl:Class>
    


    <!-- http://www.opensilex.org/vocabulary/oeso#UltrasonicWindSensor -->

    <owl:Class rdf:about="http://www.opensilex.org/vocabulary/oeso#UltrasonicWindSensor">
        <rdfs:subClassOf rdf:resource="http://www.opensilex.org/vocabulary/oeso#WindSensor"/>
        <source>skos:closeMatch Sonic anemometer [GAMP 2.4.1.5] http://www.wmo.int/pages/prog/wcp/agm/gamp/gamp_en.html</source>
        <rdfs:comment>A sonic signal is emitted by sensor transducers</rdfs:comment>
        <rdfs:label xml:lang="en">ultrasonic wind sensor</rdfs:label>
        <rdfs:label xml:lang="fr">ultrasonic wind sensor</rdfs:label>
    </owl:Class>
    


    <!-- http://www.opensilex.org/vocabulary/oeso#VariableBase -->

    <owl:Class rdf:about="http://www.opensilex.org/vocabulary/oeso#VariableBase"/>
    


    <!-- http://www.opensilex.org/vocabulary/oeso#Variety -->

    <owl:Class rdf:about="http://www.opensilex.org/vocabulary/oeso#Variety">

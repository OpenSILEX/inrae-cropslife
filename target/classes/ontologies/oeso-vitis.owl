    <!-- http://www.opensilex.org/vocabulary/oeso#focalLength -->

    <owl:ObjectProperty rdf:about="http://www.opensilex.org/vocabulary/oeso#focalLength">
        <rdfs:subPropertyOf rdf:resource="http://www.opensilex.org/vocabulary/oeso#deviceProperty"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.opensilex.org/vocabulary/oeso#Lens"/>
                    <rdf:Description rdf:about="http://www.opensilex.org/vocabulary/oeso#MultispectralCamera"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
    </owl:ObjectProperty>
    



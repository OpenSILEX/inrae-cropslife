    <owl:Class rdf:about="http://www.opensilex.org/vocabulary/oeso#CO2Sensor">
        <rdfs:subClassOf rdf:resource="http://www.opensilex.org/vocabulary/oeso#GasSensor"/>
        <rdfs:label xml:lang="en">CO2 sensor</rdfs:label>
        <rdfs:label xml:lang="fr">Capteur de CO2</rdfs:label>
    </owl:Class>
    


    <!-- http://www.opensilex.org/vocabulary/oeso#Camera -->

    <owl:Class rdf:about="http://www.opensilex.org/vocabulary/oeso#Camera">
        <rdfs:subClassOf rdf:resource="http://www.opensilex.org/vocabulary/oeso#SensingDevice"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.opensilex.org/vocabulary/oeso#pixelSize"/>
                <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.opensilex.org/vocabulary/oeso#height"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.opensilex.org/vocabulary/oeso#width"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">Camera</rdfs:label>
        <rdfs:label xml:lang="fr">Camera</rdfs:label>
    </owl:Class>
    


    <!-- http://www.opensilex.org/vocabulary/oeso#CapacitanceSensor -->

    <owl:Class rdf:about="http://www.opensilex.org/vocabulary/oeso#CapacitanceSensor">
        <rdfs:subClassOf rdf:resource="http://www.opensilex.org/vocabulary/oeso#HumiditySensor"/>
        <source>skos:closeMatch capacitance sensor [ET-AWS] http://www.hydrometeoindustry.org/Meetings2010/ET-AWS-6/Doc8[1]-AWS-MetadataCatalogues.pdf</source>
        <rdfs:comment>certain materials interact with water vapour and undergo a change in capacitance, in relation to ambient humidity.</rdfs:comment>
        <rdfs:label xml:lang="en">capacitance sensor</rdfs:label>
        <rdfs:label xml:lang="fr">capacitance sensor</rdfs:label>
    </owl:Class>
    


    <!-- http://www.opensilex.org/vocabulary/oeso#CapacitiveThinFilmPolymer -->

    <owl:Class rdf:about="http://www.opensilex.org/vocabulary/oeso#CapacitiveThinFilmPolymer">
        <rdfs:subClassOf rdf:resource="http://www.opensilex.org/vocabulary/oeso#CapacitanceSensor"/>

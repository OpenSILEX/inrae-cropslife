    <owl:NamedIndividual rdf:about="http://www.opensilex.org/vocabulary/oeso#plantEOI">
        <rdf:type rdf:resource="http://www.opensilex.org/vocabulary/oeso#EntityOfInterest"/>
        <rdfs:label xml:lang="en">plant</rdfs:label>
        <rdfs:label xml:lang="fr">plante</rdfs:label>

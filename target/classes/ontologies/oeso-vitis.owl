    <rdf:Description rdf:about="http://www.opensilex.org/vocabulary/oeso#aperture">
        <rdfs:label xml:lang="en">aperture (fnumber)</rdfs:label>
        <rdfs:label xml:lang="fr">ouverture (fnumber)</rdfs:label>

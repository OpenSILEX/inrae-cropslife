        <skos:exactMatch rdf:resource="http://www.opensilex.org/vocabulary/oeso-vitis#Leaf"/>
        <rdfs:isDefinedBy rdf:resource="http://www.opensilex.org/vocabulary/oeso-phis"/>
        <skos:historyNote xml:lang="fr">Défini dans oeso-phis 3.3 (2021-10-22), repris dans oeso-sunagri 2.0 (2022-10-05) ; remplacé par oeso-vitis:Leaf dans oeso-agrivoltaics 1.0.0 (2026-10-13).</skos:historyNote>
        <skos:historyNote xml:lang="en">Defined in oeso-phis 3.3 (2021-10-22), reused in oeso-sunagri 2.0 (2022-10-05); replaced by oeso-vitis:Leaf in oeso-agrivoltaics 1.0.0 (2026-10-13).</skos:historyNote>
        <skos:editorialNote xml:lang="fr">oeso-phis et oeso-sunagri renvoyaient à PO:0000036 (leaf vascular system) ; oeso-vitis:Leaf correspond à PO:0025034 (leaf). Si oeso-phis est chargé avec ce module, cette dépréciation entre en conflit avec lui (règle D7).</skos:editorialNote>
    </owl:Class>


    <!-- http://www.opensilex.org/vocabulary/oeso#Plot -->

    <owl:Class rdf:about="http://www.opensilex.org/vocabulary/oeso#Plot">
        <rdfs:label xml:lang="fr">obsolète parcelle</rdfs:label>
        <rdfs:label xml:lang="en">obsolete plot</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
        <dcterms:isReplacedBy rdf:resource="http://www.opensilex.org/vocabulary/oeso-vitis#ExperimentalPlot"/>
        <skos:broadMatch rdf:resource="http://www.opensilex.org/vocabulary/oeso-vitis#ExperimentalPlot"/>
        <rdfs:isDefinedBy rdf:resource="http://www.opensilex.org/vocabulary/oeso-phis"/>
        <skos:historyNote xml:lang="fr">Défini dans oeso-phis 3.3 (2021-10-22), repris dans oeso-sunagri 2.0 (2022-10-05) ; remplacé par oeso-vitis:ExperimentalPlot dans oeso-agrivoltaics 1.0.0 (2026-10-13).</skos:historyNote>
        <skos:historyNote xml:lang="en">Defined in oeso-phis 3.3 (2021-10-22), reused in oeso-sunagri 2.0 (2022-10-05); replaced by oeso-vitis:ExperimentalPlot in oeso-agrivoltaics 1.0.0 (2026-10-13).</skos:historyNote>
        <skos:editorialNote xml:lang="fr">Le sens propre à oeso-sunagri (« gestion de l'ombrage ») relève d'un facteur expérimental. Si oeso-phis est chargé avec ce module, cette dépréciation entre en conflit avec lui (règle D7).</skos:editorialNote>
    </owl:Class>


    <!-- http://www.opensilex.org/vocabulary/oeso#SubPlot -->

    <owl:Class rdf:about="http://www.opensilex.org/vocabulary/oeso#SubPlot">
        <rdfs:label xml:lang="fr">obsolète sous-parcelle</rdfs:label>
        <rdfs:label xml:lang="en">obsolete subplot</rdfs:label>

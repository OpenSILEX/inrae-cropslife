        <skos:historyNote xml:lang="en">Defined in oeso-sunagri 2.0 (2022-10-05); replaced by oeso-agrivoltaics:Truss in oeso-agrivoltaics 1.0.0 (2026-10-13).</skos:historyNote>
    </owl:Class>



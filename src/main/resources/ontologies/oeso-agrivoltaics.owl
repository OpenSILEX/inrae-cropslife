    <!-- http://www.opensilex.org/vocabulary/oeso#VNIRImage -->

    <owl:Class rdf:about="http://www.opensilex.org/vocabulary/oeso#VNIRImage">
        <rdfs:subClassOf rdf:resource="http://www.opensilex.org/vocabulary/oeso#Image"/>

    </owl:Class>


    <!-- http://www.opensilex.org/vocabulary/oeso#Dendrometer -->

    <owl:Class rdf:about="http://www.opensilex.org/vocabulary/oeso#Dendrometer">
        <rdfs:label xml:lang="fr">obsolète dendromètre</rdfs:label>
        <rdfs:label xml:lang="en">obsolete dendrometer</rdfs:label>

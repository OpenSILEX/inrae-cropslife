        <rdfs:label xml:lang="fr">obsolète rameau terminal</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
        <skos:exactMatch rdf:resource="http://www.opensilex.org/vocabulary/oeso-agrivoltaics#TerminalShoot"/>
        <skos:historyNote xml:lang="en">Defined in oeso-sunagri 2.0 (2022-10-05); replaced by oeso-agrivoltaics:TerminalShoot in oeso-agrivoltaics 1.0.0 (2026-10-13).</skos:historyNote>
        <skos:historyNote xml:lang="fr">Défini dans oeso-sunagri 2.0 (2022-10-05) ; remplacé par oeso-agrivoltaics:TerminalShoot dans oeso-agrivoltaics 1.0.0 (2026-10-13).</skos:historyNote>
    </owl:Class>
    



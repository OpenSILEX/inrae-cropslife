        <skos:exactMatch rdf:resource="http://www.opensilex.org/vocabulary/oeso-agrivoltaics#Branch"/>
        <rdfs:isDefinedBy rdf:resource="http://www.opensilex.org/vocabulary/oeso-sunagri"/>
        <skos:historyNote xml:lang="fr">Défini dans oeso-sunagri 2.0 (2022-10-05) ; remplacé par oeso-agrivoltaics:Branch dans oeso-agrivoltaics 1.0.0 (2026-10-13).</skos:historyNote>
        <skos:historyNote xml:lang="en">Defined in oeso-sunagri 2.0 (2022-10-05); replaced by oeso-agrivoltaics:Branch in oeso-agrivoltaics 1.0.0 (2026-10-13).</skos:historyNote>
    </owl:Class>


    <!-- http://www.opensilex.org/vocabulary/oeso#Bunch -->

    <owl:Class rdf:about="http://www.opensilex.org/vocabulary/oeso#Bunch">
        <rdfs:label xml:lang="fr">obsolète grappe</rdfs:label>
        <rdfs:label xml:lang="en">obsolete bunch</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
        <dcterms:isReplacedBy rdf:resource="http://www.opensilex.org/vocabulary/oeso-vitis#Bunch"/>
        <skos:closeMatch rdf:resource="http://www.opensilex.org/vocabulary/oeso-vitis#Bunch"/>
        <rdfs:isDefinedBy rdf:resource="http://www.opensilex.org/vocabulary/oeso-sunagri"/>
        <skos:historyNote xml:lang="fr">Défini dans oeso-sunagri 2.0 (2022-10-05) ; remplacé par oeso-vitis:Bunch dans oeso-agrivoltaics 1.0.0 (2026-10-13).</skos:historyNote>
        <skos:historyNote xml:lang="en">Defined in oeso-sunagri 2.0 (2022-10-05); replaced by oeso-vitis:Bunch in oeso-agrivoltaics 1.0.0 (2026-10-13).</skos:historyNote>
        <skos:editorialNote xml:lang="fr">oeso-sunagri rangeait la grappe sous Inflorescence ; oeso-vitis la définit comme une infructescence.</skos:editorialNote>
    </owl:Class>


    <!-- http://www.opensilex.org/vocabulary/oeso#Corymbe -->

    <owl:Class rdf:about="http://www.opensilex.org/vocabulary/oeso#Corymbe">

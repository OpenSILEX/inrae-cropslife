        <skos:historyNote xml:lang="en">Defined in oeso-sunagri 2.0 (2022-10-05); replaced by oeso-agrivoltaics:Dendrometer in oeso-agrivoltaics 1.0.0 (2026-10-13).</skos:historyNote>
        <skos:editorialNote xml:lang="fr">L'ancien commentaire parlait de la hauteur du tronc ; la définition sourcée porte sur les variations de diamètre.</skos:editorialNote>
    </owl:Class>


    <!-- http://www.opensilex.org/vocabulary/oeso#EuropeanInfrastructure -->

    <owl:Class rdf:about="http://www.opensilex.org/vocabulary/oeso#EuropeanInfrastructure">
        <rdfs:label xml:lang="fr">obsolète infrastructure européenne</rdfs:label>
        <rdfs:label xml:lang="en">obsolete european infrastructure</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
        <dcterms:isReplacedBy rdf:resource="http://www.opensilex.org/vocabulary/oeso-agrivoltaics#EuropeanInfrastructure"/>
        <skos:closeMatch rdf:resource="http://www.opensilex.org/vocabulary/oeso-agrivoltaics#EuropeanInfrastructure"/>
        <rdfs:isDefinedBy rdf:resource="http://www.opensilex.org/vocabulary/oeso-sunagri"/>
        <skos:historyNote xml:lang="fr">Défini dans oeso-sunagri 2.0 (2022-10-05) ; remplacé par oeso-agrivoltaics:EuropeanInfrastructure dans oeso-agrivoltaics 1.0.0 (2026-10-13).</skos:historyNote>
        <skos:historyNote xml:lang="en">Defined in oeso-sunagri 2.0 (2022-10-05); replaced by oeso-agrivoltaics:EuropeanInfrastructure in oeso-agrivoltaics 1.0.0 (2026-10-13).</skos:historyNote>
    </owl:Class>


    <!-- http://www.opensilex.org/vocabulary/oeso#ExperimentalDesign -->

    <owl:Class rdf:about="http://www.opensilex.org/vocabulary/oeso#ExperimentalDesign">
        <rdfs:label xml:lang="fr">obsolète plant d'expérience</rdfs:label>
        <rdfs:label xml:lang="en">obsolete experimental design</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
        <dcterms:isReplacedBy rdf:resource="http://www.opensilex.org/vocabulary/oeso-agrivoltaics#ExperimentalDesign"/>
        <skos:exactMatch rdf:resource="http://www.opensilex.org/vocabulary/oeso-agrivoltaics#ExperimentalDesign"/>
        <rdfs:isDefinedBy rdf:resource="http://www.opensilex.org/vocabulary/oeso-sunagri"/>
        <skos:historyNote xml:lang="fr">Défini dans oeso-sunagri 2.0 (2022-10-05) ; remplacé par oeso-agrivoltaics:ExperimentalDesign dans oeso-agrivoltaics 1.0.0 (2026-10-13).</skos:historyNote>
        <skos:historyNote xml:lang="en">Defined in oeso-sunagri 2.0 (2022-10-05); replaced by oeso-agrivoltaics:ExperimentalDesign in oeso-agrivoltaics 1.0.0 (2026-10-13).</skos:historyNote>
    </owl:Class>


    <!-- http://www.opensilex.org/vocabulary/oeso#ExperimentalSite -->


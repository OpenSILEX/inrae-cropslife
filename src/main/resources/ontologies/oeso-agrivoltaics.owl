<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.opensilex.org/vocabulary/oeso-agrivoltaics#"
     xml:base="http://www.opensilex.org/vocabulary/oeso-agrivoltaics"
     xmlns:dc="http://purl.org/dc/elements/1.1/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:foaf="http://xmlns.com/foaf/0.1/"
     xmlns:oeev="http://www.opensilex.org/vocabulary/oeev#"
     xmlns:oeso="http://www.opensilex.org/vocabulary/oeso#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:dcterms="http://purl.org/dc/terms/"
     xmlns:oeso-vitis="http://www.opensilex.org/vocabulary/oeso/viticulture#"
     xmlns:oeso-agrivoltaics="http://www.opensilex.org/vocabulary/oeso-agrivoltaics#">
    <owl:Ontology rdf:about="http://www.opensilex.org/vocabulary/oeso-agrivoltaics">
        <owl:versionIRI rdf:resource="http://www.opensilex.org/vocabulary/oeso-agrivoltaics/1.0.0"/>
        <dc:contributor>Angélique Christophe</dc:contributor>
        <dc:contributor>Antje Meyer-Berge</dc:contributor>
        <dc:contributor>Arnaud Champetier</dc:contributor>
        <dc:contributor>Jérome Chopard</dc:contributor>
        <dc:contributor>Pascal Neveu</dc:contributor>
        <dc:contributor>Perrine Jullion</dc:contributor>
        <dc:contributor>Romain Boulord</dc:contributor>
        <dc:contributor>Rémi Blanchard</dc:contributor>
        <dc:creator>Arnaud Charleroy (INRAE)</dc:creator>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-13</dcterms:created>
        <dcterms:description xml:lang="fr">Extension de oeso-core pour l&apos;expérimentation agrivoltaïque, prévue pour être chargée avec oeso-core et oeso-vitis, sans oeso-phis. Elle contient les concepts de l&apos;ancienne ontologie oeso-sunagri (et oeev-sunagri) qui ne sont définis ni dans oeso-core ni dans oeso-vitis. Les termes d&apos;oeso-phis dont dépendent le code d&apos;OpenSILEX ou les données sont importés selon MIREOT (même IRI, rdfs:isDefinedBy vers oeso-phis). Les anciens concepts sont conservés comme termes dépréciés (owl:deprecated), liés à leur remplaçant par dcterms:isReplacedBy et par une correspondance SKOS. Chaque définition est sourcée (dc:source), ou marquée « non sourcé ».</dcterms:description>
        <dcterms:description xml:lang="en">Extension of oeso-core for agrivoltaic experiments, meant to be loaded with oeso-core and oeso-vitis, without oeso-phis. It holds the concepts of the former oeso-sunagri (and oeev-sunagri) ontology that are defined neither in oeso-core nor in oeso-vitis. The oeso-phis terms that the OpenSILEX code or the data depend on are imported following MIREOT (same IRI, rdfs:isDefinedBy to oeso-phis). Former concepts are kept as deprecated terms (owl:deprecated), linked to their replacement with dcterms:isReplacedBy and a SKOS mapping. Every definition is sourced (dc:source) or marked &quot;not sourced&quot;.</dcterms:description>
        <dcterms:license rdf:resource="https://creativecommons.org/licenses/by-sa/4.0/"/>
        <dcterms:replaces rdf:resource="http://www.opensilex.org/vocabulary/oeev-sunagri"/>
        <dcterms:replaces rdf:resource="http://www.opensilex.org/vocabulary/oeso-sunagri"/>
        <dcterms:requires rdf:resource="http://www.opensilex.org/vocabulary/oeso"/>
        <dcterms:requires rdf:resource="http://www.opensilex.org/vocabulary/oeso-vitis"/>
        <dcterms:title xml:lang="en">OpenSILEX - Agrivoltaics</dcterms:title>
        <dcterms:title xml:lang="fr">OpenSILEX - Agrivoltaïsme</dcterms:title>
        <rdfs:comment xml:lang="fr">Extension de oeso-core pour l&apos;expérimentation agrivoltaïque, prévue pour être chargée avec oeso-core et oeso-vitis, sans oeso-phis. Elle contient les concepts de l&apos;ancienne ontologie oeso-sunagri (et oeev-sunagri) qui ne sont définis ni dans oeso-core ni dans oeso-vitis. Les termes d&apos;oeso-phis dont dépendent le code d&apos;OpenSILEX ou les données sont importés selon MIREOT (même IRI, rdfs:isDefinedBy vers oeso-phis). Les anciens concepts sont conservés comme termes dépréciés (owl:deprecated), liés à leur remplaçant par dcterms:isReplacedBy et par une correspondance SKOS. Chaque définition est sourcée (dc:source), ou marquée « non sourcé ».</rdfs:comment>
        <rdfs:comment xml:lang="en">Extension of oeso-core for agrivoltaic experiments, meant to be loaded with oeso-core and oeso-vitis, without oeso-phis. It holds the concepts of the former oeso-sunagri (and oeev-sunagri) ontology that are defined neither in oeso-core nor in oeso-vitis. The oeso-phis terms that the OpenSILEX code or the data depend on are imported following MIREOT (same IRI, rdfs:isDefinedBy to oeso-phis). Former concepts are kept as deprecated terms (owl:deprecated), linked to their replacement with dcterms:isReplacedBy and a SKOS mapping. Every definition is sourced (dc:source) or marked &quot;not sourced&quot;.</rdfs:comment>
        <rdfs:label xml:lang="en">OpenSILEX - Agrivoltaics</rdfs:label>
        <rdfs:label xml:lang="fr">OpenSILEX - Agrivoltaïsme</rdfs:label>
        <owl:versionInfo>Version 1.0.0 (2026-10-13) created by INRAE</owl:versionInfo>
    </owl:Ontology>
    



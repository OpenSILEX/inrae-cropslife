    <!-- http://www.opensilex.org/vocabulary/oeso#EuropeanInfrastructure -->

    <owl:Class rdf:about="http://www.opensilex.org/vocabulary/oeso#EuropeanInfrastructure">
        <dcterms:isReplacedBy rdf:resource="http://www.opensilex.org/vocabulary/oeso-agrivoltaics#EuropeanInfrastructure"/>
        <rdfs:isDefinedBy rdf:resource="http://www.opensilex.org/vocabulary/oeso-sunagri"/>
        <rdfs:label xml:lang="en">obsolete european infrastructure</rdfs:label>

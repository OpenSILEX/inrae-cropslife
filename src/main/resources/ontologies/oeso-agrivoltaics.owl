        <skos:historyNote xml:lang="en">Defined in oeso-sunagri 2.0 (2022-10-05); replaced by oeso-vitis:Berry in oeso-agrivoltaics 1.0.0 (2026-10-13).</skos:historyNote>
    </owl:Class>


    <!-- http://www.opensilex.org/vocabulary/oeso#Block -->

    <owl:Class rdf:about="http://www.opensilex.org/vocabulary/oeso#Block">
        <rdfs:label xml:lang="fr">obsolète bloc</rdfs:label>
        <rdfs:label xml:lang="en">obsolete block</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
        <dcterms:isReplacedBy rdf:resource="http://www.opensilex.org/vocabulary/oeso-vitis#Block"/>
        <skos:closeMatch rdf:resource="http://www.opensilex.org/vocabulary/oeso-vitis#Block"/>
        <rdfs:isDefinedBy rdf:resource="http://www.opensilex.org/vocabulary/oeso-sunagri"/>
        <skos:historyNote xml:lang="fr">Défini dans oeso-sunagri 2.0 (2022-10-05) ; remplacé par oeso-vitis:Block dans oeso-agrivoltaics 1.0.0 (2026-10-13).</skos:historyNote>
        <skos:historyNote xml:lang="en">Defined in oeso-sunagri 2.0 (2022-10-05); replaced by oeso-vitis:Block in oeso-agrivoltaics 1.0.0 (2026-10-13).</skos:historyNote>
        <skos:editorialNote xml:lang="fr">Définitions différentes : « groupe de plantes qui partagent les mêmes traitements » (oeso-sunagri) et « représentation structurelle de modalités de facteurs » (oeso-vitis).</skos:editorialNote>
    </owl:Class>


    <!-- http://www.opensilex.org/vocabulary/oeso#Branch -->

    <owl:Class rdf:about="http://www.opensilex.org/vocabulary/oeso#Branch">

    </owl:Class>


    <!-- http://www.opensilex.org/vocabulary/oeso#RadiometricTarget -->

    <owl:Class rdf:about="http://www.opensilex.org/vocabulary/oeso#RadiometricTarget">
        <rdfs:subClassOf rdf:resource="http://www.opensilex.org/vocabulary/oeso#Device"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.opensilex.org/vocabulary/oeso#hasRadiometricTargetMaterial"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.opensilex.org/vocabulary/oeso#hasShape"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="fr">Cible Radiométrique</rdfs:label>
        <rdfs:label xml:lang="en">Radiometric Target</rdfs:label>
        <rdfs:isDefinedBy rdf:resource="http://www.opensilex.org/vocabulary/oeso-phis"/>
        <skos:editorialNote xml:lang="fr">Terme d'oeso-phis 3.3 importé selon MIREOT (même IRI, ontologie source déclarée par rdfs:isDefinedBy) : oeso-phis n'est pas chargé avec ce module. Utilisé par l'interface d'OpenSILEX (DeviceList.vue, vocabulary:RadiometricTarget) : l'IRI doit être conservée.</skos:editorialNote>
    </owl:Class>


    <!-- http://www.opensilex.org/vocabulary/oeso#Seed -->

    <owl:Class rdf:about="http://www.opensilex.org/vocabulary/oeso#Seed">
        <rdfs:subClassOf rdf:resource="http://www.opensilex.org/vocabulary/oeso#ScientificObject"/>
        <rdfs:label xml:lang="fr">graine</rdfs:label>
        <rdfs:label xml:lang="en">seed</rdfs:label>
        <rdfs:comment xml:lang="fr">Structure végétale multi-tissulaire (PO:0025496) qui se développe à partir d'un ovule (PO:0020003) et contient l'embryon (PO:0009009) qui est protégé par un tégument (PO:0009088).</rdfs:comment>
        <rdfs:comment xml:lang="en">A multi-tissue plant structure (PO:0025496) that develops from a plant ovule (PO:0020003) and has as parts a plant embryo (PO:0009009) enclosed in a seed coat (PO:0009088).</rdfs:comment>
        <dc:source>Plant Ontology, PO:0009010 seed. http://purl.obolibrary.org/obo/PO_0009010</dc:source>
        <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/PO_0009010"/>
        <rdfs:isDefinedBy rdf:resource="http://www.opensilex.org/vocabulary/oeso-phis"/>
        <skos:editorialNote xml:lang="fr">Terme d'oeso-phis 3.3 importé selon MIREOT (même IRI, ontologie source déclarée par rdfs:isDefinedBy) : oeso-phis n'est pas chargé avec ce module.</skos:editorialNote>
    </owl:Class>


    <!-- http://www.opensilex.org/vocabulary/oeso#Rootstock -->

    <owl:Class rdf:about="http://www.opensilex.org/vocabulary/oeso#Rootstock">
        <rdfs:subClassOf rdf:resource="http://www.opensilex.org/vocabulary/oeso#ScientificObject"/>
        <rdfs:label xml:lang="fr">porte-greffe</rdfs:label>
        <rdfs:label xml:lang="en">rootstock</rdfs:label>
        <rdfs:isDefinedBy rdf:resource="http://www.opensilex.org/vocabulary/oeso-phis"/>
        <skos:editorialNote xml:lang="fr">Terme d'oeso-phis 3.3 importé selon MIREOT (même IRI, ontologie source déclarée par rdfs:isDefinedBy) : oeso-phis n'est pas chargé avec ce module. La définition d'oeso-phis, propre à la vigne, n'est pas reprise. Dans oeso-vitis, le porte-greffe d'un cep est un matériel génétique (oeso-vitis:hasRootstock).</skos:editorialNote>
    </owl:Class>


    <!-- http://www.opensilex.org/vocabulary/oeso#Scion -->

    <owl:Class rdf:about="http://www.opensilex.org/vocabulary/oeso#Scion">

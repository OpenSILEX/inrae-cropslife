        <skos:closeMatch rdf:resource="http://www.opensilex.org/vocabulary/oeso-agrivoltaics#AgrivoltaicInstallation"/>
        <skos:editorialNote xml:lang="fr">Ancien concept sans définition, homonyme de oeso:Shadows (« ombrière », actionneur) : correspondance à valider par l&apos;expert.</skos:editorialNote>
        <skos:historyNote xml:lang="en">Defined in oeso-sunagri 2.0 (2022-10-05); replaced by oeso-agrivoltaics:AgrivoltaicInstallation in oeso-agrivoltaics 1.0.0 (2026-10-13).</skos:historyNote>
        <skos:historyNote xml:lang="fr">Défini dans oeso-sunagri 2.0 (2022-10-05) ; remplacé par oeso-agrivoltaics:AgrivoltaicInstallation dans oeso-agrivoltaics 1.0.0 (2026-10-13).</skos:historyNote>
    </owl:Class>
    


    <!-- http://www.opensilex.org/vocabulary/oeso#Shoot -->

    <owl:Class rdf:about="http://www.opensilex.org/vocabulary/oeso#Shoot">
        <dcterms:isReplacedBy rdf:resource="http://www.opensilex.org/vocabulary/oeso-vitis#Shoot"/>
        <rdfs:isDefinedBy rdf:resource="http://www.opensilex.org/vocabulary/oeso-sunagri"/>
        <rdfs:label xml:lang="en">obsolete shoot</rdfs:label>
        <rdfs:label xml:lang="fr">obsolète rameau</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
        <skos:exactMatch rdf:resource="http://www.opensilex.org/vocabulary/oeso-vitis#Shoot"/>
        <skos:historyNote xml:lang="en">Defined in oeso-sunagri 2.0 (2022-10-05); replaced by oeso-vitis:Shoot in oeso-agrivoltaics 1.0.0 (2026-10-13).</skos:historyNote>
        <skos:historyNote xml:lang="fr">Défini dans oeso-sunagri 2.0 (2022-10-05) ; remplacé par oeso-vitis:Shoot dans oeso-agrivoltaics 1.0.0 (2026-10-13).</skos:historyNote>
    </owl:Class>


    <!-- http://www.opensilex.org/vocabulary/oeso#Sucker -->

    <owl:Class rdf:about="http://www.opensilex.org/vocabulary/oeso#Sucker">
        <dcterms:isReplacedBy rdf:resource="http://www.opensilex.org/vocabulary/oeso-agrivoltaics#EpicormicShoot"/>
        <rdfs:isDefinedBy rdf:resource="http://www.opensilex.org/vocabulary/oeso-sunagri"/>
        <rdfs:label xml:lang="en">obsolete sucker</rdfs:label>
        <rdfs:label xml:lang="fr">obsolète gourmand (Vigne)</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
        <skos:closeMatch rdf:resource="http://www.opensilex.org/vocabulary/oeso-agrivoltaics#EpicormicShoot"/>
        <skos:editorialNote xml:lang="fr">En anglais, « sucker » désigne aussi le drageon issu des racines (AGROVOC c_24411).</skos:editorialNote>
        <skos:historyNote xml:lang="en">Defined in oeso-sunagri 2.0 (2022-10-05); replaced by oeso-agrivoltaics:EpicormicShoot in oeso-agrivoltaics 1.0.0 (2026-10-13).</skos:historyNote>
        <skos:historyNote xml:lang="fr">Défini dans oeso-sunagri 2.0 (2022-10-05) ; remplacé par oeso-agrivoltaics:EpicormicShoot dans oeso-agrivoltaics 1.0.0 (2026-10-13).</skos:historyNote>
    </owl:Class>
    


    <!-- http://www.opensilex.org/vocabulary/oeso#TIRImage -->

    <owl:Class rdf:about="http://www.opensilex.org/vocabulary/oeso#TIRImage">
        <rdfs:subClassOf rdf:resource="http://www.opensilex.org/vocabulary/oeso#Image"/>
        <dc:source>URI: https://cmr.earthdata.nasa.gov/kms/concept/68c2baba-b9b9-41d4-89bf-07488728bc4f

Definition adapted from: NASA GCMD Science Keywords, THERMAL INFRARED (after Allaby A., Allaby M. (1999). A Dictionary of Earth Sciences).</dc:source>
        <rdfs:comment xml:lang="fr">Image du rayonnement infrarouge thermique, c&apos;est-à-dire du rayonnement infrarouge de longueur d&apos;onde comprise entre 3,0 µm et 100 µm, que les objets émettent aux températures ambiantes.</rdfs:comment>
        <rdfs:comment xml:lang="en">Image of the thermal infrared radiation, i.e. infrared radiation with a wavelength between 3.0 µm and 100 µm, which objects emit at normal environmental temperatures.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.opensilex.org/vocabulary/oeso-phis"/>
        <rdfs:label xml:lang="en">IR thermal image</rdfs:label>
        <rdfs:label xml:lang="fr">image infrarouge thermique</rdfs:label>
        <skos:editorialNote xml:lang="fr">Terme d&apos;oeso-phis 3.3 importé selon MIREOT (même IRI, ontologie source déclarée par rdfs:isDefinedBy) : oeso-phis n&apos;est pas chargé avec ce module.</skos:editorialNote>
    </owl:Class>
    




    <!-- http://purl.org/dc/elements/1.1/creator -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/elements/1.1/creator"/>
    


    <!-- http://purl.org/dc/elements/1.1/source -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/elements/1.1/source"/>

    <owl:Class rdf:about="http://www.opensilex.org/vocabulary/oeev#ManualThinning">
        <rdfs:subClassOf rdf:resource="http://www.opensilex.org/vocabulary/oeev#Thinning"/>
        <rdfs:label xml:lang="fr">Eclaircissage manuel</rdfs:label>
        <rdfs:label xml:lang="en">Manual Thinning</rdfs:label>
        <rdfs:comment xml:lang="en">Manual thinning consists in eliminating manually flowers in late spring or fruits after setting.</rdfs:comment>
        <rdfs:comment xml:lang="fr">L'éclaircissage manuel consiste à éliminer manuellement les fleurs à la fin du printemps ou les fruits après la nouaison.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="http://www.opensilex.org/vocabulary/oeev#Drought">
        <rdfs:subClassOf rdf:resource="http://www.opensilex.org/vocabulary/oeev#Incident"/>
        <rdfs:label xml:lang="fr">Sécheresse</rdfs:label>
        <rdfs:label xml:lang="en">Drought</rdfs:label>
        <rdfs:comment xml:lang="en">Abnormal prolonged period of dryness.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Sécheresse anormale et prolongée.</rdfs:comment>
    </owl:Class>

